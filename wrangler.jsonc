{
  "name": "zzy-blog",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    {
      "pattern": "blog.zzy.tw",
      "custom_domain": true
    }
  ],
  "env": {
    "preview": {
      "name": "zzy-blog-preview",
      "workers_dev": true,
      "routes": []
    }
  }
}
