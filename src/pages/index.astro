---
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import EmptyState from '@/components/EmptyState.astro'
import Section from '@/components/home/Section.astro'
import config, { HOME_DESC, HOME_TITLE } from '@/site-config'
const posts = sortMDByDate(await getBlogCollection()).slice(0, 8)
---
<PageLayout meta={{ title: 'Home', documentTitle: HOME_TITLE, description: HOME_DESC }} highlightColor='#659EB9'>
  <main class='mx-auto flex w-full flex-col items-center pb-5'>
    <section class='animate mb-14 flex flex-col items-center gap-y-6 pt-4 sm:pt-8' id='content-header'>
      <img src={config.logo.src} alt={config.logo.alt} width='112' height='112' class='rounded-full border bg-background p-1' fetchpriority='high' />
      <div class='text-center'>
        <h1 class='text-3xl font-medium sm:text-4xl'>zzy / Blog</h1>
        <p class='mt-4 text-base text-muted-foreground'>Notes, stories and small discoveries.</p>
      </div>
      <div class='flex items-center gap-x-7 text-sm text-muted-foreground'>
        <a href='https://zzy.tw/' class='inline-flex items-center gap-2'><Icon name='earth' class='size-4' />Portal</a>
        <a href='https://github.com/kevinjone25' class='inline-flex items-center gap-2' target='_blank' rel='noopener noreferrer'><Icon name='github' class='size-4' />GitHub</a>
      </div>
    </section>
    <div id='content' class='animate w-full md:w-4/5 lg:w-5/6'>
      <Section title='Latest writing'>
        {posts.length ? (
          <><ul class='flex flex-col gap-y-3'>{posts.map(post => <PostPreview post={post} />)}</ul>
          <a href='/blog' class='mt-3 w-fit self-end text-sm underline underline-offset-4'>All posts</a></>
        ) : <EmptyState />}
      </Section>
      <p class='mt-7 text-center text-xs text-muted-foreground'><a href='/rss.xml' class='underline underline-offset-4'>Follow along with RSS</a></p>
    </div>
  </main>
</PageLayout>
