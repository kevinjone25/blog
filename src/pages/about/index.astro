---
import PageLayout from '@/layouts/CommonPage.astro'
import { ABOUT_DESC, ABOUT_INTRO, BIO } from '@/site-config'
import { profilePageGraph } from '@/utils/structured-data'

const headings = [
  { depth: 2, slug: 'about-this-blog', text: 'About this blog' },
  { depth: 2, slug: 'elsewhere', text: 'Elsewhere' },
  { depth: 2, slug: 'follow', text: 'Follow' }
]
---

<PageLayout title='About' description={ABOUT_DESC} {headings} jsonLd={profilePageGraph()}>
  <h2 id='about-this-blog'>About this blog</h2>
  <p>{ABOUT_INTRO}</p>
  <p>{BIO}。</p>
  <p>This is a place for notes, ideas and things worth keeping.</p>

  <h2 id='elsewhere'>Elsewhere</h2>
  <p>
    For everything else, visit <a href='https://zzy.tw/'>my portal</a> or find me on
    <a href='https://github.com/kevinjone25' target='_blank' rel='noopener noreferrer'>GitHub</a>.
  </p>

  <h2 id='follow'>Follow</h2>
  <p>You can follow new writing through the <a href='/rss.xml'>RSS feed</a>.</p>
</PageLayout>
