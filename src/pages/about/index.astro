---
import PageLayout from '@/layouts/BaseLayout.astro'
---
<PageLayout meta={{ title: 'About', description: 'A small place for notes, ideas and things worth keeping.' }}>
  <main class='mx-auto max-w-2xl py-6 sm:py-10'>
    <div id='content-header' class='animate'>
      <p class='mb-4 text-sm text-muted-foreground'>A small corner of the internet</p>
      <h1 class='text-3xl font-medium'>About this blog</h1>
    </div>
    <div id='content' class='animate mt-8 space-y-6 leading-8 text-muted-foreground'>
      <p>I'm zzy. This is a place for notes, ideas and things worth keeping.</p>
      <p>For everything else, visit <a href='https://zzy.tw/' class='underline underline-offset-4'>my portal</a> or find me on <a href='https://github.com/kevinjone25' class='underline underline-offset-4' target='_blank' rel='noopener noreferrer'>GitHub</a>.</p>
      <p>You can follow new writing through the <a href='/rss.xml' class='underline underline-offset-4'>RSS feed</a>.</p>
    </div>
  </main>
</PageLayout>
