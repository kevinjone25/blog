---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { Paginator, PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, getUniqueTagsWithCount, sortMDByDate } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import EmptyState from '@/components/EmptyState.astro'
import config from '@/site-config'

export const getStaticPaths = (async ({ paginate }) => {
  const posts = sortMDByDate(await getBlogCollection())
  const uniqueTags = getUniqueTagsWithCount(posts).map(([tag]) => tag)
  const props = { uniqueTags, collectionsCount: posts.length }
  if (!posts.length) return [{ params: { page: undefined }, props }]
  return paginate(posts, { pageSize: config.content.blogPageSize, props })
}) satisfies GetStaticPaths

interface Props {
  page?: Page<CollectionEntry<'blog'>>
  uniqueTags: string[]
  collectionsCount: number
}
const { page, uniqueTags, collectionsCount } = Astro.props
const posts = page?.data ?? []
const paginationProps = {
  ...(page?.url.prev && { prevUrl: { text: 'Previous posts', url: page.url.prev } }),
  ...(page?.url.next && { nextUrl: { text: 'Next posts', url: page.url.next } })
}
---
<PageLayout meta={{ title: 'Blog', description: 'Notes, stories and small discoveries by zzy.' }}>
  <Button title='Home' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'><h1 class='mb-6 text-3xl font-medium'>Blog</h1></div>
    {!posts.length ? <div id='content' class='animate'><EmptyState /></div> : (
      <div class='grid gap-y-12 sm:grid-cols-[3fr_1fr] sm:gap-x-8'>
        <section id='content' class='animate' aria-label='Blog posts'>
          <div class='mb-5 flex flex-wrap justify-between gap-2 text-sm text-muted-foreground'>
            <span>{collectionsCount} post{collectionsCount === 1 ? '' : 's'}</span>
            <a href='/archives' class='underline underline-offset-4'>View archive</a>
          </div>
          <ul class='flex flex-col gap-y-4'>{posts.map(post => <PostPreview post={post} detailed />)}</ul>
          <Paginator {...paginationProps} />
        </section>
        {!!uniqueTags.length && <aside id='sidebar' class='animate'>
          <h2 class='mb-4 text-lg font-medium'>Topics</h2>
          <ul class='flex flex-wrap gap-2'>{uniqueTags.map(tag => <li><Button title={tag} href={`/tags/${tag}`} variant='pill' /></li>)}</ul>
        </aside>}
      </div>
    )}
  </main>
</PageLayout>
