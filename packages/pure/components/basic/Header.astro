---
import config from 'virtual:config'

import { Icon } from '../user'
---

<header-component
  class='group sticky top-4 z-50 max-md:z-30 mb-12 flex items-center justify-between rounded-xl border border-transparent max-sm:py-1 sm:rounded-2xl'
>
  <a
    class='z-30 text-xl font-medium group-[.not-top]:ms-2 sm:group-[.not-top]:ms-3'
    style='transition:margin-inline 0.3s'
    href='/'
    aria-label={config.title}>{config.title}</a
  >

  <div class='flex items-center gap-x-2'>
    {/* Menu links */}
    <nav
      aria-label='Main navigation'
      id='headerExpandContent'
      class='end-0 start-0 top-12 grid border border-transparent group-[.not-top]:rounded-xl group-[.expanded]:opacity-100 dark:group-[.expanded.not-top]:bg-muted max-sm:absolute max-sm:opacity-0 max-sm:group-[.not-top]:border-border max-sm:group-[.expanded.not-top]:bg-background max-sm:group-[.not-top]:px-4 max-sm:group-[.not-top]:py-2 sm:grid-rows-1'
    >
      <div class='flex flex-col items-center justify-center overflow-hidden sm:flex-row'>
        {
          config.header.menu.map((item) => (
            <a
              href={item.link}
              class='w-full flex-none grow py-2 text-right font-medium transition-none hover:text-primary sm:w-fit sm:px-3'
              data-astro-prefetch
            >
              {item.title}
            </a>
          ))
        }
        <div class='flex w-full grow flex-row justify-end gap-x-3 sm:w-fit sm:gap-x-5'>
          <a class='px-1 py-2 transition-none sm:px-2' href='/search' title='Search'>
            <span class='sr-only'>Search</span>
            <Icon name='search' class='size-5' />
          </a>
        </div>
      </div>
    </nav>

    {/* buttons */}
    <div class='z-30 flex gap-x-4 group-[.not-top]:gap-x-2' style='transition:gap 0.3s'>
      <button
        id='toggleDarkMode'
        type='button'
        data-theme='system'
        aria-label='Switch color theme'
        class='group/dark box-content size-5 rounded-md border p-1.5 transition-colors hover:bg-border sm:group-[.not-top]:rounded-xl'
      >
        <span class='sr-only'>Dark Theme</span>
        <Icon class='system size-5 group-hover/dark:text-primary' name='computer' />
        <Icon class='light hidden size-5 group-hover/dark:text-primary' name='sun' />
        <Icon class='dark hidden size-5 group-hover/dark:text-primary' name='moon' />
      </button>
      <button
        id='toggleMenu'
        type='button'
        aria-controls='headerExpandContent'
        aria-expanded='false'
        class='rounded-md border p-1.5 transition-colors hover:bg-border sm:hidden sm:group-[.not-top]:rounded-xl'
      >
        <span class='sr-only'>Menu</span>
        <Icon class='size-5' name='menu' />
      </button>
    </div>
  </div>
</header-component>

{/* Use inline to load the saved theme icon without assuming storage access. */}
<script is:inline>
  (() => {
    const button = document.getElementById('toggleDarkMode')
    if (!button) return
    let preference = 'system'
    try {
      const stored = localStorage.getItem('theme')
      if (['system', 'dark', 'light'].includes(stored)) preference = stored
    } catch {}
    button.dataset.theme = preference
  })()
</script>
<script>
  import { getTheme, setTheme, showToast } from '../../utils'

  class HeaderComponent extends HTMLElement {
    private events?: AbortController
    private mobile = window.matchMedia('(max-width: 639px)')
    private previousScroll = 0

    private get menuButton() { return this.querySelector<HTMLButtonElement>('#toggleMenu') }
    private get navigation() { return this.querySelector<HTMLElement>('#headerExpandContent') }

    private synchronizeNavigation = () => {
      if (!this.mobile.matches) this.classList.remove('expanded')
      const expanded = this.mobile.matches && this.classList.contains('expanded')
      const hidden = this.mobile.matches && !expanded
      this.menuButton?.setAttribute('aria-expanded', String(expanded))
      if (this.navigation) {
        const focusWasInside = hidden && this.navigation.contains(document.activeElement)
        this.navigation.inert = hidden
        this.navigation.setAttribute('aria-hidden', String(hidden))
        if (focusWasInside) this.menuButton?.focus()
      }
    }

    private closeMenu(restoreFocus = false) {
      this.classList.remove('expanded')
      this.synchronizeNavigation()
      if (restoreFocus) this.menuButton?.focus()
    }

    private updateThemeLabel() {
      const button = this.querySelector<HTMLButtonElement>('#toggleDarkMode')
      if (!button) return
      const preference = getTheme() || 'system'
      const order = ['system', 'dark', 'light']
      const next = order[(order.indexOf(preference) + 1) % order.length]
      button.dataset.theme = preference
      button.setAttribute('aria-label', `Color theme: ${preference}. Switch to ${next}.`)
    }

    connectedCallback() {
      this.events?.abort()
      this.events = new AbortController()
      const { signal } = this.events
      this.previousScroll = window.scrollY
      this.classList.toggle('not-top', this.previousScroll > 20)
      this.synchronizeNavigation()
      this.updateThemeLabel()

      window.addEventListener('scroll', () => {
        this.classList.toggle('not-top', window.scrollY > 20)
        this.dataset.show = (window.scrollY < 350 || window.scrollY < this.previousScroll).toString()
        this.previousScroll = window.scrollY
      }, { passive: true, signal })
      this.mobile.addEventListener('change', this.synchronizeNavigation, { signal })

      this.menuButton?.addEventListener('click', () => {
        this.classList.toggle('expanded')
        this.synchronizeNavigation()
      }, { signal })
      this.navigation?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => this.closeMenu(), { signal })
      })
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && this.classList.contains('expanded')) this.closeMenu(true)
      }, { signal })
      document.addEventListener('pointerdown', (event) => {
        if (this.classList.contains('expanded') && !this.contains(event.target as Node)) this.closeMenu()
      }, { signal })

      this.querySelector('#toggleDarkMode')?.addEventListener('click', () => {
        const preference = setTheme(undefined, true)
        this.updateThemeLabel()
        showToast({ message: `Set theme to ${preference}` })
      }, { signal })
    }

    disconnectedCallback() {
      this.events?.abort()
    }
  }

  if (!customElements.get('header-component')) customElements.define('header-component', HeaderComponent)
</script>

<style>
  header-component {
    transition:
      padding 0.3s,
      transform 0.3s,
      margin-inline 0.3s,
      border 0.15s,
      background-color 0.15s;

    &.not-top {
      --un-border-opacity: 1;
      border-color: hsl(var(--border) / var(--un-border-opacity));
      --un-bg-opacity: 1;
      background-color: hsl(var(--background) / var(--un-bg-opacity));
      padding-left: 0.375rem;
      padding-right: 0.375rem;
      box-shadow:
        rgb(255, 255, 255) 0px 0px 0px 0px,
        rgba(24, 24, 27, 0.08) 0px 0px 0px 1px,
        rgba(39, 39, 42, 0.08) 0px 10px 15px -3px,
        rgba(39, 39, 42, 0.08) 0px 4px 6px -4px;
    }
    &[data-show='false']:not(.expanded) {
      transform: translateY(-5rem);
    }
  }
  @media (min-width: 800px) {
    header-component.not-top {
      margin-inline: 8%;
    }
  }
  :global(.dark) header-component.not-top {
    background-color: hsl(var(--muted) / var(--un-bg-opacity));
  }

  /* header menu */
  @media (max-width: 639px) {
    #headerExpandContent {
      grid-template-rows: 0fr;
      transition:
        opacity 0.3s,
        padding 0.3s,
        border-color 0.15s,
        grid-template-rows 0.3s;
    }
    .expanded #headerExpandContent {
      grid-template-rows: 1fr;
    }
    .expanded.not-top #headerExpandContent {
      box-shadow:
        rgb(255, 255, 255) 0px 0px 0px 0px,
        rgba(24, 24, 27, 0.08) 0px 0px 0px 1px,
        rgba(39, 39, 42, 0.08) 0px 10px 15px -3px,
        rgba(39, 39, 42, 0.08) 0px 4px 6px -4px;
    }

    /* header component after */
    header-component #headerExpandContent::after {
      box-sizing: content-box;
      content: '';
      position: absolute;
      inset-inline: calc(-1rem - 1px);
      bottom: 0;
      top: -5rem;
      z-index: -1;
      transition: 0.3s;
      visibility: hidden;
      opacity: 0;
      border-bottom: 1px solid transparent;
    }
    header-component:not(.not-top) #headerExpandContent::after {
      visibility: visible;
      bottom: -1rem;
      opacity: 1;
      background-color: hsl(var(--muted) / var(--un-bg-opacity, 1));
      border-bottom-color: hsl(var(--border) / var(--un-border-opacity, 1));
    }
  }

  /* dark light mode toggle */
  #toggleDarkMode {
    &[data-theme='dark'] {
      & .system {
        display: none;
      }
      & .dark {
        display: block;
      }
    }
    &[data-theme='light'] {
      & .system {
        display: none;
      }
      .light {
        display: block;
      }
    }
  }
</style>
