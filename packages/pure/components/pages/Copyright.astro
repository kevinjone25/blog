---
import type { CollectionKey, InferEntrySchema } from 'astro:content'
import config from 'virtual:config'
import { cn, getFormattedDate } from '../../utils'
import { Icon } from '../user'

interface Props<T extends CollectionKey> {
  data: InferEntrySchema<T>
  class?: string
}

const { data, class: className } = Astro.props
const { title, publishDate } = data
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href
---

<div class={cn('relative flex flex-col gap-y-3 rounded-xl border px-4 py-3', className)}>
  <div class='flex flex-col gap-y-1'>
    <div class='font-medium text-foreground'>{title}</div>
    <a href={canonicalUrl} class='break-all text-sm'>{canonicalUrl}</a>
  </div>
  <div class='flex flex-wrap items-center justify-between gap-3 text-sm'>
    <span>
      © {config.author}
      {publishDate && <span> · {getFormattedDate(publishDate, { month: 'long' })}</span>}
    </span>
    <button
      data-copy-link
      aria-label='Copy article link'
      class='inline-flex items-center gap-2 rounded-lg border px-3 py-1.5 transition-colors hover:bg-muted'
    >
      <Icon class='size-4' name='link' />
      <span>Copy link</span>
    </button>
  </div>
</div>

<script>
  import { showToast } from '../../utils'

  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href)
        showToast({ message: 'Link copied!' })
      } catch {
        showToast({ message: 'Copy the link from your browser’s address bar.' })
      }
    })
  })
</script>
