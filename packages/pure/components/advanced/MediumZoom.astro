---
// https://github.com/francoischalifour/medium-zoom
import config from 'virtual:config'

interface Props {
  selector?: string
  background?: string
}

const { selector = config.integ.mediumZoom.selector, background = 'hsl(var(--background) / 0.8)' } =
  Astro.props
---

<image-zoom data-selector={selector} data-background={background} aria-hidden='true'></image-zoom>

<script>
  import mediumZoom, { type Zoom } from 'medium-zoom'

  class ImageZoom extends HTMLElement {
    zoom?: Zoom

    initialize = () => {
      this.zoom?.detach()
      this.zoom = mediumZoom(this.dataset.selector || '.prose .zoomable', {
        background: this.dataset.background || 'rgba(0, 0, 0, 0.8)'
      })
    }

    connectedCallback() {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', this.initialize, { once: true })
      } else {
        this.initialize()
      }
      document.addEventListener('astro:page-load', this.initialize)
    }

    disconnectedCallback() {
      document.removeEventListener('DOMContentLoaded', this.initialize)
      document.removeEventListener('astro:page-load', this.initialize)
      this.zoom?.detach()
    }
  }

  if (!customElements.get('image-zoom')) customElements.define('image-zoom', ImageZoom)
</script>

<style is:global>
  .medium-zoom-overlay { z-index: 999; }
  .medium-zoom-image--opened { z-index: 1000; }
  @media (prefers-reduced-motion: reduce) {
    .medium-zoom-overlay, .medium-zoom-image { transition: none !important; }
  }
</style>
